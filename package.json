{
  "name": "machine-agent-org-ui",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build:web": "bun run --cwd frontend build",
    "check:web": "bun run --cwd frontend check",
    "backend:dev": "bun run backend/src/index.ts",
    "factory": "bun run backend/src/cli.ts",
    "factory:bun": "bun run backend/src/cli.ts",
    "mrl": "bun run backend/mrl/cli.ts",
    "mrl:bun": "bun run backend/mrl/cli.ts",
    "build:test-images": "bun run tools/build_test_images.ts",
    "backend:check": "bun build backend/src/index.ts --target bun --outfile output/backend-check.js",
    "backend:build": "bun build backend/src/index.ts --outdir output/backend --target bun",
    "backend:bench": "bun run backend/bench.ts",
    "runtime:doctor": "bun run backend/src/cli.ts runtime doctor",
    "verify:official-harness": "bun run tools/verify-official-harness.ts",
    "backend:test": "bun test backend/tests",
    "acceptance:bun": "bun run tools/harness.ts acceptance",
    "verify:bun": "bun run tools/harness.ts verify"
  },
  "workspaces": [
    "frontend"
  ]
}
