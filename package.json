{
  "name": "machine-agent-org-ui",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build:web": "pnpm --filter @mao/web build",
    "check:web": "pnpm --filter @mao/web check",
    "backend:dev": "bun run backend/src/index.ts",
    "factory:bun": "bun run backend/src/cli.ts",
    "backend:check": "bun build backend/src/index.ts --target bun --outfile output/backend-check.js",
    "backend:build": "bun build backend/src/index.ts --outdir output/backend --target bun",
    "backend:bench": "bun run backend/bench.ts",
    "backend:test": "bun test backend/tests"
  }
}
