{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mao.local/schemas/machine.schema.json",
  "title": "Machine（智能机器 / Machine Package 主描述）",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "mao/v1"},
    "kind": {"const": "Machine"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["form", "runtime", "recipes"],
      "additionalProperties": false,
      "properties": {
        "form": {"enum": ["workspace", "service", "tool"]},
        "source": {
          "type": "object",
          "required": ["repo", "commit"],
          "additionalProperties": false,
          "properties": {
            "repo": {"type": "string"},
            "commit": {"type": "string"}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": {"type": "string"},
            "compose": {"type": "string"},
            "workdir": {"type": "string"},
            "service": {"type": "object"},
            "instance": {"enum": ["once", "per_job", "pooled", "resident"]},
            "command": {"$ref": "common.schema.json#/$defs/stringList"},
            "health": {"type": "object"},
            "restart": {"type": "object"},
            "emit_per_min": {"type": "integer"},
            "pool_size": {"type": "integer"},
            "reset": {"oneOf": [{"type": "string"}, {"$ref": "common.schema.json#/$defs/stringList"}]},
            "resources": {"type": "object"},
            "caches": {"type": "array"}
          },
          "oneOf": [{"required": ["image"]}, {"required": ["compose"]}]
        },
        "operate": {"type": "object"},
        "needs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secrets": {"$ref": "common.schema.json#/$defs/stringList"},
            "egress": {},
            "budget_knobs": {"type": "array"},
            "config_render": {},
            "rate_limits": {},
            "secret_checks": {
              "type": "object",
              "propertyNames": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "additionalProperties": {
                "type": "object",
                "required": ["run", "timeout_s"],
                "additionalProperties": false,
                "properties": {
                  "run": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "timeout_s": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        },
        "recipes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "common.schema.json#/$defs/name"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {"type": "string"},
              "inputs": {
                "type": "object",
                "propertyNames": {"$ref": "common.schema.json#/$defs/ident"},
                "additionalProperties": {
                  "type": "object",
                  "required": ["type"],
                  "additionalProperties": false,
                  "properties": {
                    "type": {"$ref": "common.schema.json#/$defs/typeExpr"},
                    "place": {"type": "string"},
                    "optional": {"type": "boolean"}
                  }
                }
              },
              "params": {
                "type": "object",
                "propertyNames": {"$ref": "common.schema.json#/$defs/ident"},
                "additionalProperties": {"$ref": "common.schema.json#/$defs/paramDecl"}
              },
              "outputs": {
                "type": "object",
                "propertyNames": {"$ref": "common.schema.json#/$defs/ident"},
                "additionalProperties": {
                  "type": "object",
                  "required": ["type"],
                  "additionalProperties": false,
                  "properties": {
                    "type": {"$ref": "common.schema.json#/$defs/typeExpr"},
                    "harvest": {},
                    "optional": {"type": "boolean"}
                  }
                }
              },
              "task_template": {"type": "string"},
              "call": {"type": "object"},
              "run": {"$ref": "common.schema.json#/$defs/stringList"},
              "propose": {"$ref": "common.schema.json#/$defs/stringList"},
              "receipt": {
                "type": "object",
                "required": ["target", "locator"],
                "additionalProperties": false,
                "properties": {
                  "target": {"type": "string"},
                  "locator": {
                    "type": "object",
                    "additionalProperties": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "probe": {"type": "object"},
        "conformance": {"type": "array"}
      }
    }
  }
}
