[Unit]
Description=MAO Bun control plane
Wants=network-online.target podman.socket
After=network-online.target podman.socket

[Service]
Type=simple
WorkingDirectory=%h/mao
EnvironmentFile=-%h/.config/mao/control-plane.env
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=FACTORY_ROOT=%h/.local/share/mao
Environment=FACTORY_DB_PATH=%h/.local/share/mao/factory.db
Environment=BUSINESS_DB_PATH=%h/.local/share/mao/factory.db
Environment=MAO_CONTAINER_RUNTIME=podman
Environment=MAO_WEB_DIST=%h/mao/frontend/dist
ExecStartPre=/usr/bin/podman info --format '{{.Host.Os}}'
ExecStart=/usr/bin/env bun run backend/src/index.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
