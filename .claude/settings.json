{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python tools/hooks/protect_paths.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
